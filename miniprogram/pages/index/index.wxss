/* pages/index/index.wxss */

.page {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: linear-gradient(160deg, #F4FBF2 0%, #DDF3D7 100%);
  background-attachment: fixed;
}

/* ── Hero ──────────────────────────────────────────────────────────── */
.hero {
  padding: 72rpx 40rpx 48rpx;
  text-align: center;
}

.hero-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2A1F;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.hero-sub {
  font-size: 28rpx;
}

/* ── 输入卡片 ──────────────────────────────────────────────────────── */
.input-card {
  padding: 36rpx 36rpx 28rpx;
}

.input-label {
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.input-row {
  position: relative;
  background: #F4FBF2;
  border: 2rpx solid #D8E9D6;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  min-height: 96rpx;
  display: flex;
  align-items: flex-start;
}

.link-input {
  /* flex:1 在小程序 textarea 上需要配合 width:0 才能正确伸缩 */
  flex: 1;
  width: 0;
  font-size: 30rpx;
  color: #1F2A1F;
  line-height: 48rpx;
  min-height: 48rpx;
  background: transparent;
  border: 0;
  padding: 0;
  padding-right: 48rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: #A8BCA8;
  font-size: 30rpx;
}

.clear-btn {
  position: absolute;
  right: 20rpx;
  top: 24rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #C8DCC8;
  border-radius: 50%;
}

.clear-icon {
  font-size: 22rpx;
  color: #fff;
  line-height: 1;
}

/* ── 按钮行 ────────────────────────────────────────────────────────── */
.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-paste {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 40rpx;
  background: #E8F7E8;
  color: #58AE58;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.btn-fetch {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #7DD27A 0%, #5FB55E 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  letter-spacing: 1rpx;
}

.btn-fetch-loading {
  opacity: 0.7;
}

.btn-fetch-disabled {
  opacity: 0.4;
}

/* ── Spinner ───────────────────────────────────────────────────────── */
.spinner-small {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255,255,255,0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ── 使用说明卡片 ──────────────────────────────────────────────────── */
.tips-card {
  padding: 32rpx 36rpx;
}

.tips-title {
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.tip-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
  align-items: flex-start;
}

.tip-dot {
  color: #72C472;
  font-size: 26rpx;
  line-height: 1.6;
  flex-shrink: 0;
}

.tip-text {
  font-size: 26rpx;
  line-height: 1.6;
}

/* ── 版本信息 ───────────────────────────────────────────────────────── */
.version-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 32rpx 0;
}

.version-text {
  color: #8BA88A;
  font-size: 20rpx;
  line-height: 1.4;
  word-break: break-all;
}
